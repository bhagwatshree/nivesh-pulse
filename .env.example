# Copy to .env.local (already gitignored) and fill in once you have:
#   1. An Upstox developer app: https://upstox.com/developer/apps
#   2. The proxy deployed: see server/upstox-proxy/README.md

# The OAuth client id from your Upstox developer app. NOT secret — this is
# fine to expose to the browser (it's literally embedded in the authorize
# URL the browser is redirected to). The client SECRET never goes here or
# anywhere in this frontend; it lives only in the Cloudflare Worker's secret
# store (server/upstox-proxy).
VITE_UPSTOX_CLIENT_ID=

# Must exactly match the redirect URI registered on the Upstox app AND the
# ALLOWED_ORIGINS entry in server/upstox-proxy/wrangler.toml. For the
# deployed app this is:
VITE_UPSTOX_REDIRECT_URI=https://bhagwatshree.github.io/nivesh-pulse/

# The deployed Cloudflare Worker URL from `npm run deploy` in
# server/upstox-proxy, e.g. https://nivesh-pulse-upstox-proxy.<subdomain>.workers.dev
VITE_UPSTOX_PROXY_URL=
