# Non-secret build-time config for the production (GitHub Pages) deploy.
# None of these values are confidential — see .env.example for why. The
# actual client secret lives only in Cloudflare's secret store
# (server/upstox-proxy), never in this repo.

VITE_UPSTOX_CLIENT_ID=bf33a8bc-53c7-4172-bbf8-4423c98998b6
VITE_UPSTOX_REDIRECT_URI=https://bhagwatshree.github.io/nivesh-pulse/
VITE_UPSTOX_PROXY_URL=https://nivesh-pulse-upstox-proxy.bhagwatshree.workers.dev

# Groww passthrough — same deployed Worker as Upstox above (it now proxies
# both), kept as its own var since the two integrations aren't code-coupled.
# No client id/secret here: Groww uses a manually-pasted dashboard token
# instead (see src/hooks/useGrowwSession.ts).
VITE_GROWW_PROXY_URL=https://nivesh-pulse-upstox-proxy.bhagwatshree.workers.dev
